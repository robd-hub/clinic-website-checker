# Optional. Turns on a closer spelling read. Any OpenAI-compatible chat API.
# Leave blank and the checker still runs, using a lighter spelling check.
CHECKER_LLM_API_KEY=
CHECKER_LLM_BASE_URL=https://api.openai.com/v1
CHECKER_LLM_MODEL=gpt-4o-mini

# Where to send "before-and-after" enquiries. See the README for a Google Sheet.
LEADS_WEBHOOK_URL=

# Optional. If you connect a Vercel Blob store, enquiries are also saved there as private files.
BLOB_READ_WRITE_TOKEN=
